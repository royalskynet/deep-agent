#!/bin/bash
# deep-run <task.md> [cwd] — the only entry point that runs deepclaude outside the
# sandbox (settings.json sandbox.excludedCommands). Logs paths and rc only, never
# content, never credential values.
#
# Slimming flags (measured 2026-09-12): default prefix 22,132 → ~5.5k tokens/turn,
# and the creds-egress-guard PreToolUse hook still fires. No `--bare`: the docs say
# it skips hooks, and it does — measured, even with --settings — which disarms the
# guard.
#
# GH_TOKEN: the gh keyring is unusable headless, so the value is injected from the
# kv mirror instead; that is what lets deep `gh search` for an existing wheel.
set -u

DC_HOME="${DC_HOME:-$HOME/.deepclaude}"
CREDS_DIR="${CREDS_DIR:-$HOME/.creds}"
# launchd and sandbox-excluded shells hand over a minimal PATH; deepclaude and node
# live in one of these on both machines.
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
command -v deepclaude >/dev/null || { echo "deep-run: deepclaude not on PATH" >&2; exit 2; }

# deep is a headless main loop with no Agent tool, so it never produces subagent
# traffic. Pin the cheap model directly and hand the main loop the same harness the
# subagent path gets, plus the loop guard (see repo/proxy/model-proxy.js).
export CHEAPERINFERENCE_MODEL="${CHEAPERINFERENCE_MODEL:-deepseek-v4-flash-0731}"
export DC_MAIN_HARNESS_FILE="${DC_MAIN_HARNESS_FILE:-$DC_HOME/repo/proxy/subagent-harness.md}"
export DC_LOOP_GUARD="${DC_LOOP_GUARD:-on}"

# Sandbox guard: the allowlist entry is the literal string "deep-run *", so calling
# this by absolute path silently drops back into the sandbox (node DNS dies at once
# and fakes a 502).
case "${HTTPS_PROXY:-}" in
    *localhost:*|*127.0.0.1:*)
        echo "deep-run: running INSIDE sandbox — call bare 'deep-run', not the full path" >&2
        exit 3 ;;
esac

f=${1:-}; d=${2:-$DC_HOME/work}
WLOG="${WLOG:-$HOME/Library/Logs/openclaw/wrappers.log}"
case "$f" in /*) ;; *) echo "deep-run: task path must be absolute: $f" >&2; exit 2 ;; esac
[ -f "$f" ] || { echo "deep-run: task file not found: $f" >&2; exit 2; }
[ -d "$d" ] || { echo "deep-run: cwd not found: $d" >&2; exit 2; }

GHK="$CREDS_DIR/kv/GITHUB_PERSONAL_ACCESS_TOKEN.txt"
[ -r "$GHK" ] && GH_TOKEN=$(cat "$GHK") && export GH_TOKEN
# No kv mirror (fresh machine): fall back to the logged-in gh keyring. deep-run runs
# outside the sandbox, so the keyring is reachable here even though it is not headless-safe.
[ -z "${GH_TOKEN:-}" ] && GH_TOKEN=$(gh auth token 2>/dev/null) && export GH_TOKEN

mkdir -p "$(dirname "$WLOG")"
echo "$(date '+%F %T') deep-run start $f cwd=$d" >> "$WLOG"
cd "$d" || exit 2
# --system-prompt-file replaces Claude Code's default prompt, and the environment
# block that normally names the working directory goes with it. deep then has no way
# to know where it was started: one measured run spent five rounds on `find $HOME
# -type d -name src` before giving up empty-handed, which is both wasted turns and the
# kind of broad filesystem scan the operating rules forbid. State the cwd instead.
deepclaude -p "$(cat "$f")" --output-format text \
  --system-prompt-file "$DC_HOME/config/deep-system.md" \
  --append-system-prompt "Working directory: $d — you are already in it. Every relative path in the task resolves under it. Do not search the filesystem for the task's files; if something is missing, \`ls\` here and report what is actually present." \
  --tools Bash,Read,Edit,Write,Glob,Grep \
  --disable-slash-commands \
  --strict-mcp-config \
  --permission-mode bypassPermissions \
  --max-turns 150
rc=$?
echo "$(date '+%F %T') deep-run end rc=$rc $f" >> "$WLOG"

# Summary anti-hallucination: append objective transcript stats so the model's final
# prose is not the only output — a headless run's summary is the one part of it that
# cannot be verified from the outside. Claude Code names the transcript
# directory after the cwd with / and . both replaced by -.
SLUG=$(printf '%s' "$d" | sed 's/[\/.]/-/g')
TRANS="$(ls -t "$DC_HOME/config/projects/$SLUG/"*.jsonl 2>/dev/null | head -1)"
if [ -n "$TRANS" ] && [ -f "$TRANS" ]; then
  echo "deep-run transcript: tool_use=$(jq -r 'select(.type=="assistant" and .message) | .message.content[]? | select(.type=="tool_use") | .id' "$TRANS" 2>/dev/null | wc -l | tr -d ' ')"
  echo "last_tool_result: $(jq -r 'select(.type=="user" and .message) | .message.content[]? | select(.type=="tool_result") | .content' "$TRANS" 2>/dev/null | tail -1 | cut -c1-300)"
else
  echo "deep-run transcript: none"
fi
exit $rc
